{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devexcalculator.org/schemas/rate-registry.schema.json",
  "title": "DevEx rate registry",
  "description": "Validates src/data/rates.json. Rate values are decimal STRINGS, never JSON numbers: a JSON number is parsed as a double, and 0.0038 is not representable in binary floating point, so storing it as a number would lose the exactness the calculation engine depends on.",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryVersion",
    "lastVerifiedAt",
    "reviewCadenceDays",
    "criticalReviewAgeDays",
    "minimum",
    "rates",
    "marketplace",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "registryVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "lastVerifiedAt": { "type": "string", "format": "date-time" },
    "reviewCadenceDays": { "type": "integer", "minimum": 1 },
    "criticalReviewAgeDays": { "type": "integer", "minimum": 1 },
    "minimum": {
      "type": "object",
      "required": ["eligibleEarnedRobux", "sourceIds", "lastVerifiedAt", "note"],
      "additionalProperties": false,
      "properties": {
        "eligibleEarnedRobux": { "type": "integer", "minimum": 1 },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 20 }
      }
    },
    "rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "shortLabel",
          "usdPerRobux",
          "usdPerThousandRobux",
          "effectiveFrom",
          "effectiveTo",
          "status",
          "eligibilitySummary",
          "conditionNote",
          "sourceIds",
          "lastVerifiedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 3 },
          "shortLabel": { "type": "string", "minLength": 1 },
          "usdPerRobux": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$",
            "description": "Exact decimal string. Must be positive."
          },
          "usdPerThousandRobux": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$",
            "description": "Must equal usdPerRobux x 1000 exactly. Enforced at load time in rate-registry.ts, which JSON Schema cannot express."
          },
          "effectiveFrom": { "type": ["string", "null"], "format": "date-time" },
          "effectiveTo": { "type": ["string", "null"], "format": "date-time" },
          "status": { "enum": ["active", "conditional", "legacy", "retired"] },
          "eligibilitySummary": { "type": "string", "minLength": 20 },
          "conditionNote": { "type": ["string", "null"] },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Every publicly displayed rate must cite at least one official source."
          },
          "lastVerifiedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "marketplace": {
      "type": "object",
      "required": ["lastVerifiedAt", "sourceIds", "schemes"],
      "additionalProperties": false,
      "properties": {
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "description",
              "creatorSharePercent",
              "platformSharePercent",
              "progressive",
              "sourceIds"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "label": { "type": "string", "minLength": 3 },
              "description": { "type": "string", "minLength": 10 },
              "creatorSharePercent": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
              "platformSharePercent": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
              "experienceOwnerSharePercent": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
              "progressive": { "type": "boolean" },
              "progressiveTiers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["priceFloorMultiple", "creatorSharePercent"],
                  "additionalProperties": false,
                  "properties": {
                    "priceFloorMultiple": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
                    "creatorSharePercent": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" }
                  }
                }
              },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["maxRobuxInput", "maxUsdTargetInput", "note"],
      "additionalProperties": false,
      "properties": {
        "maxRobuxInput": { "type": "integer", "minimum": 1 },
        "maxUsdTargetInput": { "type": "integer", "minimum": 1 },
        "note": {
          "type": "string",
          "minLength": 40,
          "description": "Must state that these are application limits, not Roblox limits."
        }
      }
    }
  }
}
