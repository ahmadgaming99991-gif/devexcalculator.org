# Cloudflare Workers Static Assets headers.
#
# Applied to static assets served directly from the assets binding, which the
# Worker never sees. Headers for dynamic responses are set in next.config.ts —
# the adapter does not support Node-runtime middleware, so there is no
# middleware file to hold them.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Next.js fingerprints every file under /_next/static, so the content at a
# given URL can never change. A year of immutable caching is safe and is what
# the Cloudflare and OpenNext guidance recommends.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# The brand mark. A week rather than a year, and deliberately not immutable:
# the filename is stable, so a revised logo would otherwise sit in a returning
# reader's cache until 2027. A week is long enough that almost nobody fetches
# it twice and short enough that a correction actually lands.
/brand/*
  Cache-Control: public, max-age=604800

# Small text files that should refresh promptly when the site is redeployed.
/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
