{
  "name": "devexcalculator-org",
  "version": "1.0.0",
  "private": true,
  "description": "DevEx Calculator — Roblox Developer Exchange payout estimator for creators.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "node scripts/local/with-cf-auth.mjs npm run preview:run",
    "upload": "node scripts/local/with-cf-auth.mjs --require-env npm run upload:run",
    "deploy": "node scripts/local/with-cf-auth.mjs --require-env npm run deploy:run",
    "cf-build": "opennextjs-cloudflare build",
    "cf-typegen": "node scripts/local/with-cf-auth.mjs wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "seo:analyze": "tsx scripts/seo/analyze-keywords.ts",
    "seo:indexnow": "tsx scripts/seo/indexnow.ts",
    "seo:search-console": "tsx scripts/seo/analyze-search-console.ts",
    "validate:content": "node scripts/support/with-server-conditions.mjs scripts/content/validate-content.ts",
    "validate:freshness": "tsx scripts/content/validate-freshness-claims.ts",
    "validate:seo": "tsx scripts/seo/generate-seo-report.ts --check",
    "validate:links": "tsx scripts/quality/check-links.ts",
    "validate:routes": "tsx scripts/quality/check-routes.ts",
    "validate:worker": "tsx scripts/quality/check-worker-size.ts",
    "validate:bundle": "tsx scripts/quality/check-bundle-budget.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:content && npm run validate:freshness && npm run validate:seo && npm run validate:i18n && npm run validate:data-dictionary && npm run validate:jsx-text && npm run validate:hardcoded && npm run validate:client-words && npm run validate:interpolation && npm run i18n:audit && npm run validate:localized-og && npm run build && npm run validate:static-routes && npm run validate:routes && npm run validate:links && npm run validate:duplicates && npm run validate:bundle && npm run cf-build && npm run cf-populate && npm run validate:worker",
    "fx:snapshot": "tsx scripts/content/generate-fx-snapshot.ts",
    "test:visual": "playwright test --project=visual",
    "validate:duplicates": "tsx scripts/seo/detect-near-duplicate-content.ts",
    "verify:deployment": "tsx scripts/quality/verify-deployment.ts",
    "cf-populate": "opennextjs-cloudflare populateCache local",
    "validate:i18n": "tsx scripts/i18n/validate-dictionaries.ts",
    "validate:interpolation": "tsx scripts/i18n/validate-interpolation.ts",
    "validate:client-words": "tsx scripts/i18n/validate-client-words.ts",
    "validate:data-dictionary": "tsx scripts/i18n/sync-data-dictionary.ts --check",
    "i18n:sync-data": "tsx scripts/i18n/sync-data-dictionary.ts",
    "og:localized": "node scripts/support/with-server-conditions.mjs scripts/og/build-localized-cards.ts",
    "validate:localized-og": "node scripts/support/with-server-conditions.mjs scripts/og/build-localized-cards.ts --check",
    "validate:leakage": "tsx scripts/i18n/detect-language-leakage.ts",
    "validate:localized-html": "tsx scripts/i18n/validate-localized-html.ts",
    "i18n:audit": "tsx scripts/i18n/audit/run.ts",
    "i18n:inventory": "tsx scripts/i18n/inventory-english.ts",
    "i18n:extract-routes": "tsx scripts/i18n/extract-routes.ts",
    "i18n:dictionaries": "tsx scripts/i18n/inventory-dictionaries.ts",
    "i18n:hardcoded": "tsx scripts/i18n/detect-hardcoded.ts",
    "i18n:extract-prose": "tsx scripts/i18n/extract-page-prose.ts",
    "i18n:prune": "tsx scripts/i18n/prune-orphans.ts",
    "i18n:wiring": "tsx scripts/i18n/build-wiring-map.ts",
    "i18n:extract-templates": "tsx scripts/i18n/extract-templates.ts",
    "i18n:rename": "tsx scripts/i18n/rename-keys.ts",
    "purge:cache": "node scripts/local/with-cf-auth.mjs tsx scripts/deploy/purge-cache.ts",
    "validate:jsx-text": "tsx scripts/i18n/validate-jsx-text.ts",
    "validate:hardcoded": "tsx scripts/i18n/detect-hardcoded.ts --check",
    "validate:rendered-tokens": "tsx scripts/i18n/validate-rendered-tokens.ts",
    "validate:static-routes": "tsx scripts/quality/check-static-routes.ts",
    "preview:run": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --var DISABLE_HTTPS_UPGRADE:1",
    "upload:run": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy:run": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && npm run purge:cache",
    "doctor": "node scripts/local/doctor.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.6",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
