# ---------------------------------------------------------------------------
# DevExCalculator.org — build-time / public environment variables
#
# Copy to `.env.local` for local development. Every value below is OPTIONAL.
# The application builds and runs correctly with all of them unset; optional
# integrations simply stay disabled and render no UI and no scripts.
#
# NEVER put a secret in a NEXT_PUBLIC_* variable — those are inlined into the
# client bundle. Server-only secrets belong in `.dev.vars` (local) or
# Cloudflare Worker secrets (production). See `.dev.vars.example`.
# ---------------------------------------------------------------------------

# Absolute canonical origin, no trailing slash.
# Defaults to https://devexcalculator.org when unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty to disable GA4 entirely (no script is emitted).
NEXT_PUBLIC_GA4_ID=

# Cloudflare Web Analytics beacon token.
# Leave empty to disable (no beacon script is emitted).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare Turnstile PUBLIC site key. Safe to expose.
# Only used when CONTACT_MODE is a server submission mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Publicly displayed contact mailbox. Leave empty to omit any published
# address; the contact page then explains that contact is unavailable rather
# than showing a fabricated mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal organization name used in Organization JSON-LD and legal pages.
# Leave empty until a real registered name is confirmed — when empty, no
# Organization node with a fabricated name is emitted.
NEXT_PUBLIC_ORGANIZATION_NAME=

# Google Search Console ownership token — the `content` value of the
# `google-site-verification` meta tag, not the whole tag. Leave empty to emit
# no tag. A DNS TXT record verifies the same property without putting a token
# in every page, and is preferred where DNS is available.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership token — the `content` value of the
# `msvalidate.01` meta tag. Leave empty to emit no tag. Bing also accepts
# importing the property directly from Search Console, which needs no tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster ownership tag ("yandex-verification"). Sixteen characters.
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# Renders the locales whose translations exist but have not been read by a
# native speaker. UNSET IN PRODUCTION, and anything other than the exact
# string `true` is treated as false — a typo here must fail closed, because
# failing open serves six unreviewed languages about people's income.
#
# This controls whether those pages RENDER. It never makes them public: a
# `review` locale stays out of hreflang, the sitemap, IndexNow and the
# language selector whatever this is set to. See src/i18n/visibility.ts.
ENABLE_REVIEW_LOCALES=

# SEOSignalX patch tag — the complete script URL from that tool's "Install the
# JavaScript tag" dialog, deployment and key query parameters included. Leave
# empty to render no tag; the CSP then does not name the origin either.
#
# The whole URL rather than the key alone, because the vendor owns the shape of
# it. Not a secret — the tag is readable in the page source — but it identifies
# an account, so it stays out of a public repository.
#
# This tag rewrites the page in the reader's browser. Nothing in the build
# constrains what a published patch may say, so a patch touching a rate, a
# payout or an eligibility claim is outside every guard this repository has.
# See src/components/seo/seo-tooling.tsx.
NEXT_PUBLIC_SEOSIGNALX_TAG_SRC=
