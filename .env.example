# ---------------------------------------------------------------------------
# DevExCalculator.org — build-time / public environment variables
#
# Copy to `.env.local` for local development. Every value below is OPTIONAL.
# The application builds and runs correctly with all of them unset; optional
# integrations simply stay disabled and render no UI and no scripts.
#
# NEVER put a secret in a NEXT_PUBLIC_* variable — those are inlined into the
# client bundle. Server-only secrets belong in `.dev.vars` (local) or
# Cloudflare Worker secrets (production). See `.dev.vars.example`.
# ---------------------------------------------------------------------------

# Absolute canonical origin, no trailing slash.
# Defaults to https://devexcalculator.org when unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty to disable GA4 entirely (no script is emitted).
NEXT_PUBLIC_GA4_ID=

# Cloudflare Web Analytics beacon token.
# Leave empty to disable (no beacon script is emitted).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare Turnstile PUBLIC site key. Safe to expose.
# Only used when CONTACT_MODE is a server submission mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Publicly displayed contact mailbox. Leave empty to omit any published
# address; the contact page then explains that contact is unavailable rather
# than showing a fabricated mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal organization name used in Organization JSON-LD and legal pages.
# Leave empty until a real registered name is confirmed — when empty, no
# Organization node with a fabricated name is emitted.
NEXT_PUBLIC_ORGANIZATION_NAME=
