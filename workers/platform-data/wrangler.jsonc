{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  /*
   * The platform data plane, production configuration.
   *
   * This Worker serves `/platform/`'s figures to the reader's browser and
   * collects them on a schedule. It is deliberately separate from the site
   * Worker: the site is a Next.js application near the 3 MB bundle limit, and
   * a per-request render of `/platform/` measured a median of 134 ms of CPU
   * against the Workers Free plan's 10 ms, which produced `error code: 1102`.
   * Nothing here has a framework, a bundler config, or a dependency.
   *
   * The staging deployment this was proven on
   * (`devexcalculator-platform-data-proof`, workers.dev only, throwaway
   * namespace 7eab89c7af41467f915ef4a2c6d52f7c, no cron) still exists and can
   * be removed once production has soaked. Nothing in `src/` differs between
   * the two: the Worker does not read its own environment name and has no
   * staging-only branch, so what was measured there is what runs here.
   */
  "name": "devexcalculator-platform-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  /*
   * One public origin, and it is the one the site's CSP names.
   *
   * A workers.dev subdomain would publish this same data under a second
   * hostname that nothing links to and no policy mentions. There is nothing
   * secret here - every endpoint is a public read - but an origin nobody uses
   * is still an origin to keep track of.
   */
  "workers_dev": false,
  "routes": [{ "pattern": "api.devexcalculator.org", "custom_domain": true }],

  /*
   * Every five minutes, one unit.
   *
   * `dispatch` chooses the unit from the wall clock, and the schedule exists so
   * that no invocation ever carries two of them - combining the hourly history
   * append with the collection cycle measured 12.35-23.15 ms against a 10 ms
   * plan limit. See src/dispatch.ts for the minute-by-minute allocation.
   */
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  /*
   * The v2 namespace, not the v1 collector's store.
   *
   * The v1 collector's keys are unprefixed (`obs:`, `index`, `series`, `games`,
   * `heartbeat`) and live in namespace 8f880ad3328f42bb86272bee6e76542b. Every
   * key this Worker writes carries the `platform:v2:` prefix, so the two could
   * share a namespace without colliding - but they do not, which means a
   * mistake here cannot reach the data the live site is currently serving.
   *
   * v1 keeps collecting through the dual-run. See docs/platform-data-cutover.md
   * for why retiring it is gated on the public exports rather than on this
   * Worker being healthy.
   */
  "kv_namespaces": [
    {
      "binding": "PLATFORM_DATA",
      "id": "a8b623a0b4324f7bab0b61f38769c208"
    }
  ],

  // Per-invocation CPU is how this Worker's safety is verified, and the
  // minute-bucketed analytics dataset cannot give it for runs seconds apart.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
