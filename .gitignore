# typescript
*.tsbuildinfo

# Operator secrets pasted into the working tree.
# Never committed. Provider keys belong in Cloudflare secrets, not in the repo,
# and a file dropped here must not be one `git add -A` away from being public.
keys.txt
keys*.txt
*.key
secrets.txt

# Machine-local credential LOCATIONS (never values).
#
# .claude/local.json records where this computer keeps the Cloudflare token
# and which GitHub account owns the remote, so a future session finds the
# existing credentials instead of starting a browser login. The committed
# template beside it shows the shape.
.claude/local.json

# private analytics exports
#
# Search Console performance data is the owner's data about their own
# property. Committing it would publish a list of every query this site is
# seen for, which is not something a public repository should carry.
/private/

# Generated i18n coverage reports. Deterministic, but regenerated by the
# validator on every run — read from the run, not from the repository.
/dist/
