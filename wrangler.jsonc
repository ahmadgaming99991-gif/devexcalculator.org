{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devexcalculator-org",
  // The generated OpenNext worker handles `fetch` only. worker/index.ts
  // delegates to it and adds the `scheduled` handler the Cron Trigger needs.
  "main": "worker/index.ts",
  "alias": {
    // Resolved here so the entry can import the generated worker without a
    // relative path to a file that does not exist until `cf-build` runs.
    "opennext-worker": "./.open-next/worker.js"
  },
  "compatibility_date": "2026-06-01",

  /*
   * Cloudflare checks the cache before invoking this Worker.
   *
   * `/platform/` renders per request at ~125 ms of CPU, and the site's
   * `error code: 1102` rate under a burst tracks per-request CPU almost
   * exactly. A `caches.default` lookup at the top of the Worker skipped the
   * React render but still paid isolate startup, which is part of what
   * produces the error; this does not run the Worker at all on a hit.
   *
   * Turning this on changes what an absent `Cache-Control` means, from "this
   * site does not cache it" to "something other than this repository decides".
   * So every response leaving the Worker is given an explicit policy, ending
   * in `no-store` when nothing claimed it — `resolveCachePolicy` in
   * src/lib/cache/platform-cache.ts, asserted in its tests. Every response
   * class was enumerated against a running Worker before this was enabled and
   * none was found unlabelled.
   *
   * `cross_version_cache` is deliberately left off. A copy taken from the
   * previous deployment could otherwise be served after a new one, which is
   * the "cached page that has quietly stopped moving" failure with a longer
   * reach — a deploy starts clean instead.
   */
  "cache": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Both hostnames route to this Worker. `www` is not a DNS alias: it must
  // reach the Worker so the redirect in next.config.ts can send it to the
  // apex with a 308, which is what keeps one canonical origin.
  "routes": [
    { "pattern": "devexcalculator.org", "custom_domain": true },
    { "pattern": "www.devexcalculator.org", "custom_domain": true }
  ],
  /*
   * No schedule. The site no longer collects anything.
   *
   * This used to run every fifteen minutes to write the v1 snapshots. That job
   * now belongs to the platform data Worker, which collects into its own
   * namespace on its own trigger and serves the result from
   * api.devexcalculator.org. Leaving the cron here would keep a second,
   * unread collector writing against the same 1,000-writes-a-day account
   * budget that the data plane needs.
   *
   * The v1 namespace below stays bound and stays populated: it is the rollback
   * path until the v2 plane has proven itself, and nothing deletes it. See
   * docs/platform-data-cutover.md for the retirement steps and the cleanup
   * date.
   *
   * Declared empty rather than omitted: Wrangler leaves existing Cron Triggers
   * untouched when the key is absent, so an omitted block would have left the
   * old schedule running on the deployed Worker.
   */
  "triggers": {
    "crons": []
  },

  // The only stored state on the site. Snapshots expire after 14 days, so
  // retention needs no cleanup job. See docs/decision-log.md, D-027.
  "kv_namespaces": [
    {
      "binding": "PLATFORM_HISTORY",
      "id": "8f880ad3328f42bb86272bee6e76542b"
    },
    /*
     * The v2 data plane, read-only from here.
     *
     * `/api/platform/` publishes the observations as CSV and JSON, and those
     * URLs are linked from the page. They read this namespace so that retiring
     * the v1 collector cannot leave a public download silently frozen. Nothing
     * in the site writes to it - the data Worker owns every key.
     */
    {
      "binding": "PLATFORM_DATA",
      "id": "a8b623a0b4324f7bab0b61f38769c208"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Required by @opennextjs/cloudflare so the Worker can invoke itself for
  // cache revalidation. This is not an extra product binding.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "devexcalculator-org"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://devexcalculator.org",
    "FX_PROVIDER": "ecb",
    "FX_CACHE_TTL_SECONDS": "43200",
    "CONTACT_MODE": "disabled",
    // Which market-data adapter serves /platform/stock/. The matching
    // STOCK_API_KEY is a Worker secret, set with `wrangler secret put`, and is
    // deliberately not in this file.
    "STOCK_PROVIDER": "finnhub"
  }
  // No KV / D1 / R2 / Durable Object / Queue bindings are declared.
  // The calculator is stateless, FX responses use the Workers Cache API via
  // `fetch` caching, and contact submissions are disabled by default.
  // See docs/architecture.md § State and storage policy.
}
